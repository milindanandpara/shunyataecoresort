<section class="orders bg-gray-50 py-12 min-h-screen">
  <div class="container mx-auto px-4">
    <% if (messages.success) { %>
      <div class="bg-green-500 text-white px-4 py-3 rounded mb-4" id="flash-message">
        <%= messages.success %>
      </div>
    <% } %>
    <% if (messages.error) { %>
      <div class="bg-red-500 text-white px-4 py-3 rounded mb-4" id="flash-message">
        <%= messages.error %>
      </div>
    <% } %>

    <h1 class="text-2xl font-bold text-gray-800 mb-6">Your Bookings</h1>

    <% if (bookings.length) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% bookings.forEach(booking => { %>
          <div class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col hover:scale-105 transition-transform duration-200 booking-card" data-id="<%= booking.id %>">
            
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <h2 class="text-lg font-semibold text-gray-800 mb-1">
                  Booking ID:
                  <a href="/customer/orders/<%= booking.id %>" class="text-blue-500 underline"><%= booking.id %></a>
                </h2>

                <p class="text-sm text-gray-600 mb-1"><strong>Phone:</strong> <%= booking.customerPhone %></p>
                <p class="text-sm text-gray-600 mb-1"><strong>Address:</strong> <%= booking.customerAddress %></p>
                <p class="text-sm text-gray-600 mb-1"><strong>Total Price:</strong> ₹<%= booking.totalPrice %></p>

                <p class="text-sm text-gray-600 mb-1"><strong>Payment Status:</strong> 
                  <span class="text-green-600 font-semibold">Confirmed</span>
                </p>

                <p class="text-sm text-gray-600 mb-2"><strong>Booking Time:</strong> 
                  <%= moment(booking.createdAt).format('DD-MM-YYYY hh:mm A') %>
                </p>

                <!-- Booking Status -->
                <p class="text-sm font-medium mb-2">
                  <strong>Status:</strong> 
                  <span class="status-badge px-2 py-1 rounded text-white 
                    <% if (booking.status === 'pending') { %> bg-yellow-500 <% } else if (booking.status === 'confirmed') { %> bg-green-600 <% } else { %> bg-red-500 <% } %>">
                    <%= booking.status %>
                  </span>
                </p>
              </div>

              <div class="mt-4 action-section">
                <% if (booking.status === 'panding') { %>
                  <form action="/customer/booking/cancel/<%= booking.id %>" method="POST" class="cancel-form">
                    <button type="submit" class="bg-red-500 text-white px-3 py-2 rounded hover:bg-red-600 transition">Cancel Booking</button>
                  </form>
                <% } else { %>
                  <p class="text-sm text-gray-500">Booking confirmed or cancelled.</p>
                <% } %>
              </div>
            </div>

            <% if (booking.items && Object.keys(booking.items).length > 0) { %>
              <div class="border-t bg-gray-100 px-4 py-3">
                <p class="text-sm font-medium text-gray-700 mb-2">Rooms:</p>
                <% Object.values(booking.items).forEach(item => { %>
                  <div class="flex items-center gap-3 mb-2">
                    <% if (Array.isArray(item.item.images) && item.item.images.length > 0) { %>
                      <img src="<%= item.item.images[0] %>" alt="<%= item.item.name %>" class="w-16 h-16 object-cover rounded">
                    <% } else { %>
                      <img src="/img/default.png" alt="No Image" class="w-16 h-16 object-cover rounded">
                    <% } %>
                    <div>
                      <p class="text-gray-800 text-sm"><%= item.item.name %> (<%= item.qty %>)</p>
                      <p class="text-gray-500 text-xs">₹<%= item.item.price %> per night</p>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center text-gray-600 mt-12">
        <p>No bookings found.</p>
      </div>
    <% } %>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 space-y-3"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    // Confirm cancel
    document.querySelectorAll('.cancel-form').forEach(form => {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (confirm("Are you sure you want to cancel this booking?")) {
          this.submit();
        }
      });
    });

    // Auto remove flash messages
    setTimeout(() => {
      const flash = document.getElementById("flash-message");
      if(flash) flash.remove();
    }, 3000);

    // ✅ Function to show toast notifications
    function showToast(message, type = "info") {
      const toast = document.createElement("div");
      toast.className = `
        px-4 py-3 rounded shadow-lg text-white animate-fadeIn
        ${type === "success" ? "bg-green-600" : type === "error" ? "bg-red-600" : "bg-blue-600"}
      `;
      toast.textContent = message;
      document.getElementById("toast-container").appendChild(toast);
      
      setTimeout(() => {
        toast.classList.add("opacity-0", "transition", "duration-500");
        setTimeout(() => toast.remove(), 500);
      }, 4000);
    }

    // Socket live updates
    socket.on('bookingUpdated', data => {
      const card = document.querySelector(`.booking-card[data-id=${data.id}]`);
      if (card) {
        const badge = card.querySelector('.status-badge');
        const actionSection = card.querySelector('.action-section');

        badge.textContent = data.status;
        badge.className = status-badge `px-2 py-1 rounded text-white transition-all duration-500`;

        if (data.status === 'confirmed') {
          badge.classList.add('bg-green-600');
          actionSection.innerHTML = <p class="text-sm text-gray-500">Booking confirmed.</p>;
          showToast("✅ Your booking has been confirmed!", "success");
        } else if (data.status === 'cancelled') {
          badge.classList.add('bg-red-500');
          actionSection.innerHTML = <p class="text-sm text-gray-500">Booking cancelled.</p>;
          showToast("❌ Your booking has been cancelled!", "error");
        } else {
          badge.classList.add('bg-yellow-500');
          showToast("🔄 Booking status updated.", "info");
        }
      }
    });
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
      animation: fadeIn 0.4s ease-out;
    }
  </style>
</section>