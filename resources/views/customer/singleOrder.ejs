<section class="status">
    <div class="container mx-auto">
        <div class="status-box w-full lg:w-2/3 mx-auto">
            <div class="flex items-center justify-between mb-12">
                <h1 class="text-xl font-bold">Traccia lo stato della consegnas</h1>
                <h6 class="bg-white py-1 rounded-full px-4 text-green-600 text-xs"><%=
                    order.id %></h6>
                <input id="hiddenInput" type="hidden" value="<%= JSON.stringify(order) %>">
            </div>
            <ul>
                <li class="status_line text-sm md:text-xl pb-16" data-status="order_placed"><span>Ordine effettuato</span>
                </li>
                <li class="status_line text-sm md:text-xl pb-16" data-status="confirmed"><span>Conferma dell'ordine</span>
                </li>
                <li class="status_line text-sm md:text-xl pb-16" data-status="packed"><span>imballato</span></li>
                <li class="status_line text-sm md:text-xl pb-16" data-status="delivered"><span>In consegna </span>
                </li>
                <li class="status_line text-sm md:text-xl" data-status="completed"><span>Completare</span></li>
            </ul>
        </div>
    </div>
</section>