<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canceled Orders</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

    <div class="container mx-auto p-4">
        <h1 class="text-3xl font-bold text-center mb-6 text-gray-800">Your Cancelled Bookings</h1>

        <% if (cencelorders.length === 0) { %>
            <p class="text-center text-gray-600">No cancelled bookings found.</p>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% cencelorders.forEach(order => { %>
                    <div class="bg-white shadow-md rounded-lg p-5 hover:shadow-lg transition-shadow duration-300">
                        <h2 class="text-xl font-semibold text-gray-800 mb-2">Booking #<%= order.id %></h2>
                        <p class="text-gray-600 mb-2"><strong>Customer Name:</strong> <%= order.name %></p>
                        <p class="text-gray-600 mb-2"><strong>Phone:</strong> <%= order.phone %></p>
                        <p class="text-gray-600 mb-2"><strong>Total Price:</strong> $<%= order.totalPrice %></p>
                        <p class="text-gray-600 mb-2"><strong>Payment Status:</strong> <%= order.paymentStatus %></p>
                        <p class="text-gray-600 mb-2"><strong>Address:</strong> <%= order.address %></p>
                        <p class="text-gray-600 mb-2"><strong>Status:</strong> 
                            <span class="inline-block px-2 py-1 text-sm rounded 
                                <%= order.status === 'canceled' ? 'bg-red-100 text-red-600' : 'bg-yellow-100 text-yellow-600' %>">
                                <%= order.status %>
                            </span>
                        </p>
                        <p class="text-gray-500 text-sm mt-3"><strong>Date:</strong> <%= new Date(order.createdAt).toLocaleDateString() %></p>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

</body>
</html>