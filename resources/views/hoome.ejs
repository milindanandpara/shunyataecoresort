<!-- AXIOS -->
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
let currentImages = [];
let currentIndex = 0;

document.addEventListener("DOMContentLoaded", async function () {

  try {
    const { data: rooms } = await axios.get("/api/room-types");

    const container = document.getElementById("roomsGrid");
    container.innerHTML = "";

    if (!rooms.length) {
      container.innerHTML = `
        <p class="text-center text-gray-500 col-span-3">
          No rooms available.
        </p>`;
      return;
    }

    rooms.forEach((rt) => {

      // ✅ images parse safe
      let images = rt.images || [];
      if (typeof images === "string") {
        try { images = JSON.parse(images); } catch(e) { images = []; }
      }

      // 🔥 image fix
      const img = images.length 
        ? encodeURI(images[0]) 
        : "/img/default-room.jpg";

      const card = document.createElement("div");
      card.className = "bg-white rounded-xl overflow-hidden shadow-lg hover:scale-105 transition duration-300";

      card.innerHTML = `
        <!-- IMAGE -->
        <div class="relative h-56 overflow-hidden cursor-pointer"
             onclick='openSlider(${JSON.stringify(images)})'>

          <img src="${img}" 
               onerror="this.src='/img/default-room.jpg'"
               class="w-full h-full object-cover transition-transform duration-500 hover:scale-110">

          ${rt.quantity > 5 ? `
            <div class="absolute top-3 right-3 bg-green-600 text-white px-3 py-1 rounded">
              Popular
            </div>` : ''}
        </div>

        <!-- CONTENT -->
        <div class="p-5">
          <h3 class="text-xl font-bold">${rt.name}</h3>

          <p class="text-sm text-gray-600 mt-2">
            ${(rt.description || '').substring(0,100)}
            ${(rt.description && rt.description.length > 100 ? '...' : '')}
          </p>

          <div class="mt-4 flex items-center justify-between">
            <div>
              <div class="text-xl font-bold">
                ₹${rt.pricePerNight}
                <span class="text-sm font-normal">/ night</span>
              </div>

              <p class="text-sm text-gray-500">
                Capacity: <strong>${rt.capacity}</strong>
              </p>

              <p class="text-sm text-gray-500">
                Rooms: <strong>${rt.quantity}</strong>
              </p>
            </div>

            <button 
              class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded transition"
              onclick="selectRoom('${rt.id}')">
              Book
            </button>
          </div>
        </div>
      `;

      container.appendChild(card);
    });

  } catch (err) {
    console.error(err);

    document.getElementById("roomsGrid").innerHTML = `
      <p class="text-center text-red-500 col-span-3">
        Failed to load rooms.
      </p>`;
  }

});


// 🔥 OPEN SLIDER
function openSlider(images) {
  if (!images.length) return;

  currentImages = images.map(img => encodeURI(img));
  currentIndex = 0;

  document.getElementById("imageModal").classList.remove("hidden");
  document.getElementById("imageModal").classList.add("flex");

  showImage();
}

// 🔥 SHOW IMAGE
function showImage() {
  document.getElementById("sliderImage").src = currentImages[currentIndex];
}

// 🔥 NEXT
function nextImg() {
  currentIndex = (currentIndex + 1) % currentImages.length;
  showImage();
}

// 🔥 PREV
function prevImg() {
  currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
  showImage();
}

// 🔥 CLOSE
function closeSlider() {
  const modal = document.getElementById("imageModal");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

// 🔥 BOOK SELECT
function selectRoom(roomId) {
  const select = document.getElementById("roomType");

  if(select){
    select.value = roomId;
    document.getElementById("booking")
      .scrollIntoView({ behavior: "smooth" });
  }
}
</script>
