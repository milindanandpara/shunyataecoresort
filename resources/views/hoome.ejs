<!-- views/searchRooms.ejs -->
<section id="booking" class="relative w-full px-4 -mt-40 mb-12 z-20">
  <div class="max-w-5xl mx-auto bg-white shadow-2xl rounded-2xl p-4 sm:p-6 relative">

    <form id="bookingForm" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
      <!-- Check-in -->
      <div>
        <label class="block text-sm font-semibold mb-1">Check-in</label>
        <input id="checkin" type="text" placeholder="Select Check-in" class="w-full border p-2 rounded-lg focus:ring-2 focus:ring-green-500" required>
      </div>

      <!-- Check-out -->
      <div>
        <label class="block text-sm font-semibold mb-1">Check-out</label>
        <input id="checkout" type="text" placeholder="Select Check-out" class="w-full border p-2 rounded-lg focus:ring-2 focus:ring-green-500" required>
      </div>

      <!-- Room Type -->
      <div>
        <label class="block text-sm font-semibold mb-1">Room Type</label>
        <select id="roomType" class="w-full border p-2 rounded-lg focus:ring-2 focus:ring-green-500">
          <option value="">-- Select Room Type --</option>
          <% if (roomTypes && roomTypes.length) { %>
            <% roomTypes.forEach(rt => { %>
              <option value="<%= rt.id %>"><%= rt.name %> <% if(rt.capacity) { %>— max <%= rt.capacity %><% } %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Guests -->
      <div>
        <label class="block text-sm font-semibold mb-1">Guests</label>
        <select id="guests" class="w-full border p-2 rounded-lg focus:ring-2 focus:ring-green-500">
          <option value="1">1 Guest</option>
          <option value="2" selected>2 Guests</option>
          <option value="3">3 Guests</option>
          <option value="4">4+ Guests</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div class="sm:col-span-2 md:col-span-4">
        <button type="submit" id="checkBtn" class="w-full bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-bold transition transform hover:scale-105">
          🔍 Check Availability
        </button>
      </div>
    </form>

    <!-- Results Container -->
    <div id="results" class="hidden mt-8">
      <h2 class="text-xl font-bold mb-4">Available Rooms</h2>
      <div id="roomsContainer" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"></div>
    </div>

  </div>
</section>

<!-- Flatpickr -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
