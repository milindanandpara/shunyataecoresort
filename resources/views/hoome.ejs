      e.preventDefault();
      const ci = $('#ci').val(); const co = $('#co').val(); const guests = $('#guests').val(); const dest = $('#dest').val();
      if(!ci || !co){ alert('Please select check-in and check-out dates'); return; }
      // demo modal (replace with AJAX)
      alert('Searching availability for ' + dest + ' from ' + ci + ' to ' + co + ' for ' + guests);
    });

  </script></body>
