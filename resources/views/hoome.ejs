<!-- Lightbox2 CSS & JS for image slider -->
<link href="https://cdn.jsdelivr.net/npm/lightbox2@2/dist/css/lightbox.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/lightbox2@2/dist/js/lightbox.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {

  flatpickr("#checkin", { minDate: "today", altInput: true, altFormat: "F j, Y", dateFormat: "Y-m-d" });
  flatpickr("#checkout", { minDate: "today", altInput: true, altFormat: "F j, Y", dateFormat: "Y-m-d" });

  const form = document.getElementById("bookingForm");

  form.addEventListener("submit", async function(e) {
    e.preventDefault();

    const checkin = document.getElementById("checkin").value;
    const checkout = document.getElementById("checkout").value;
    const roomType = document.getElementById("roomType").value;
    const guests = document.getElementById("guests").value;

    if (!checkin || !checkout) { alert("Please select both check-in and check-out dates."); return; }
    if (new Date(checkout) <= new Date(checkin)) { alert("Check-out must be after check-in."); return; }

    const btn = document.getElementById("checkBtn");
    btn.disabled = true; btn.textContent = "Searching...";

    try {
      const { data: rooms } = await axios.post("/api/search-rooms", { checkin, checkout, roomType, guests });
      const container = document.getElementById("roomsContainer");
      container.innerHTML = "";

      if (!rooms.length) {
        container.innerHTML = '<p class="text-center text-gray-500 w-full">No rooms available for selected dates.</p>';
      } else {
       rooms.forEach(rt => {
  const images = (() => { try { return JSON.parse(rt.images || '[]'); } catch { return []; } })();
  const img = images.length ? images[0] : "/img/default-room.jpg";

  const card = document.createElement("div");
  card.className = "bg-white rounded-xl shadow-lg overflow-hidden transform hover:scale-105 transition duration-300";
  card.innerHTML = `
    <img src="${img}" id="roomImg-${rt.id}" class="w-full h-48 object-cover cursor-pointer">
    <div class="p-4 space-y-2">
      <h3 class="font-bold text-lg">${rt.name}</h3>
      <p class="text-gray-600 text-sm">${(rt.description||'').substring(0,120)}${(rt.description && rt.description.length>120 ? '...' : '')}</p>
      <div class="flex items-center justify-between mt-2">
        <div>
          <p class="text-green-700 font-semibold">₹${rt.pricePerNight}/night</p>
          <p class="text-sm text-gray-500">Capacity: <strong>${rt.capacity}</strong> • Available: <strong>${rt.available}</strong></p>
        </div>
      </div>
    </div>
    <div class="w-36">
      <button class="bookNowBtn w-full ${rt.available > 0 ? 'bg-blue-600 hover:bg-blue-700' : 'bg-gray-400 cursor-not-allowed'} text-white py-2 rounded-lg transition"
        data-room='${JSON.stringify({id: rt.id, name: rt.name, price: rt.pricePerNight, checkin, checkout, guests})}'
        ${rt.available === 0 ? 'disabled' : ''}>
        🏨 Book Now
      </button>
    </div>
  `;
  container.appendChild(card);

  document.getElementById(`roomImg-${rt.id}`).addEventListener("click", () => openRoomSlider(images));
});

        container.querySelectorAll(".bookNowBtn").forEach(btn => {
          btn.addEventListener("click", () => {
            const room = JSON.parse(btn.dataset.room);
            addToPrebooking(room);
          });
        });
      }

      document.getElementById("results").classList.remove("hidden");
      document.getElementById("results").scrollIntoView({ behavior: "smooth" });

    } catch(err) { console.error(err); alert("Something went wrong while searching. Try again."); }
    finally { btn.disabled=false; btn.textContent="🔍 Check Availability"; }
  });
async function addToPrebooking(room) {
    try {
        const { data: res } = await axios.post("/prebooking/add", room);
        document.querySelector('#cartCounter').innerText = res.totalQty;

        // Show notification
        new Noty({ 
            type: 'success', 
            timeout: 1000, 
            text: 'Room added to prebooking', 
            progressBar: false 
        }).show();

        // Redirect after 1 second (1000 ms)
        setTimeout(() => {
            window.location.href = "/pre-confirm-booking";
        }, 1000);

    } catch(err) {
        console.error(err);
        if(err.response && err.response.status === 401) window.location.href = "/login";
        else alert("Could not add to prebooking. Try again.");
    }
}

  function openRoomSlider(images) {
    if(!images.length) return;
    const tempContainerId="tempRoomSlider";
    let tempContainer=document.getElementById(tempContainerId);
    if(!tempContainer){ tempContainer=document.createElement("div"); tempContainer.id=tempContainerId; tempContainer.style.display="none"; document.body.appendChild(tempContainer); }
    tempContainer.innerHTML="";
    images.forEach((src,idx)=>{
      const a=document.createElement("a");
      a.href=src;
      a.setAttribute("data-lightbox","room-slider");
      a.setAttribute("data-title",`Image ${idx+1}`);
      tempContainer.appendChild(a);
    });
    tempContainer.querySelector("a").click();
  }

});
</script>
