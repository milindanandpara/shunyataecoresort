    AOS.init({once:true, duration:800});

    // flatpickr
    flatpickr('.flatpickr', { minDate: 'today', dateFormat: 'Y-m-d' });

    // counters animate in sequence
    function runCountersSequentially(){
      const counters = document.querySelectorAll('.counter');
      let index=0;
      function runNext(){
        if(index>=counters.length) return;
        const el = counters[index];
        const target = parseInt(el.getAttribute('data-target')) || 0;
        let start = 0; const duration = 900; const step = Math.max(1, Math.floor(target/(duration/30)));
        const iv = setInterval(()=>{ start+=step; if(start>=target){ start=target; clearInterval(iv); index++; setTimeout(runNext,200); } el.innerText = start; },30);
      }
      runNext();
    }
    runCountersSequentially();

    // initialize swiper for testimonials
    var swiper = new Swiper('.mySwiper', {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      pagination: { el: '.swiper-pagination', clickable: true },
      breakpoints: { 768:{ slidesPerView:2 }, 1024:{ slidesPerView:3 }}
    });

    // countdown timers
    function initCountdown(){
      document.querySelectorAll('[data-countdown]').forEach(function(el){
        const end = new Date(el.getAttribute('data-countdown'));
        function tick(){
          const now = new Date();
          const diff = end - now;
          if(diff<=0){ el.innerText = 'Offer ended'; return; }
          const days = Math.floor(diff/ (1000*60*60*24));
          const hrs = Math.floor((diff/ (1000*60*60))%24);
          const mins = Math.floor((diff/ (1000*60))%60);
          el.innerText = days + 'd ' + hrs + 'h ' + mins + 'm';
        }
        tick(); setInterval(tick,60000);
      });
    }
    initCountdown();

    // booking search click (demo) - replace with AJAX to availability API
