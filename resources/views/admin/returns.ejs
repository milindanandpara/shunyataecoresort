<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Returns</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Richieste di reso del prodotto</h1>

        <% if (returns.length === 0) { %>
            <p class="text-gray-600 text-center">Nessuna richiesta di reso trovata.</p>
        <% } else { %>
            <table class="w-full border-collapse border border-gray-300">
                <thead>
                    <tr class="bg-gray-200">
                        <th class="p-3 border">ID di ritorno</th>
                        <th class="p-3 border">Dettagli utente (ID utente e e-mail) </th>
                      
                        <th class="p-3 border">ID ordine</th>
                    
                        <th class="p-3 border">Motivo</th>
                        <th class="p-3 border">Stato</th>
                        <th class="p-3 border">Azione</th>
                    </tr>
                </thead>
                <tbody>
                    <% returns.forEach(returnRequest => { %>
                        <tr class="text-center bg-white border">
                            <td class="p-3 border"><%= returnRequest.id %></td>
                            <td class="p-3 border"><%= returnRequest.userId %> (<%= user.email %>)</td>
                            <td class="p-3 border"><%= returnRequest.orderId %></td>
                          
                            <td class="p-3 border"><%= returnRequest.description %></td>
                            <td class="p-3 border font-bold 
                                <%= returnRequest.status === 'Pending' ? 'text-yellow-600' : returnRequest.status === 'Approved' ? 'text-green-600' : 'text-red-600' %>">
                                <%= returnRequest.status %>
                            </td>
                            <td class="p-3 border">
                                <% if (returnRequest.status === "Pending") { %>
                                    <form action="/admin/returns/update" method="POST" class="inline-block">
                                        <input type="hidden" name="returnId" value="<%= returnRequest.id %>">
                                        <input type="hidden" name="status" value="Approved">
                                        <button type="submit" class="px-3 py-2 bg-green-500 text-white rounded hover:bg-green-400 transition">
                                            Approvare
                                        </button>
                                    </form>
                                    <form action="/admin/returns/update" method="POST" class="inline-block">
                                        <input type="hidden" name="returnId" value="<%= returnRequest.id %>">
                                        <input type="hidden" name="status" value="Rejected">
                                        <button type="submit" class="px-3 py-2 bg-red-500 text-white rounded hover:bg-red-400 transition">
                                            Rifiutare
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-gray-500">Nessuna azione</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>