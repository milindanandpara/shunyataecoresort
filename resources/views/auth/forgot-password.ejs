<section class="forgot-password pt-24 bg-gray-50 min-h-screen flex items-center justify-center">
  <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden">
    
    <!-- Header / Banner -->
    <div class="h-48 bg-cover bg-center relative flex items-center justify-center"
         style="background-image: url(/img/banner.jpeg');">
      <div class="absolute inset-0 bg-black bg-opacity-40"></div>
      <h2 class="relative text-white text-3xl font-extrabold text-center z-10 drop-shadow-lg">
        Forgot Your Password?
      </h2>
    </div>

    <!-- Form Body -->
    <div class="p-8 space-y-6">
      
      <% if (messages.success) { %>
          <div class="bg-green-100 text-green-800 px-4 py-3 rounded-md shadow">
            <%= messages.success %>
          </div>
      <% } %>
      
      <% if (messages.error) { %>
          <div class="bg-red-100 text-red-800 px-4 py-3 rounded-md shadow">
            <%= messages.error %>
          </div>
      <% } %>

      <p class="text-gray-600 text-center mb-4">
        Enter your registered email address below and we'll send you a link to reset your password.
      </p>

      <form class="space-y-4" action="/forgot-password" method="POST">
        <div>
          <label for="email" class="sr-only">Email address</label>
          <input id="email" name="email" type="email" required
                 class="appearance-none rounded-xl relative block w-full px-4 py-3 border border-gray-300 
                        placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-500 
                        focus:border-green-500 sm:text-sm shadow-sm"
                 placeholder="Enter your registered email">
        </div>

        <div>
          <button type="submit"
                  class="group relative w-full flex justify-center py-3 px-6 border border-transparent text-sm font-medium 
                         rounded-xl text-white bg-green-600 hover:bg-green-700 focus:outline-none 
                         focus:ring-2 focus:ring-offset-2 focus:ring-green-500 shadow-lg transition-all duration-300">
            Send Reset Link
          </button>
        </div>
      </form>

      <p class="text-center text-sm text-gray-500 mt-4">
        Remembered your password? 
        <a href="/login" class="text-green-600 hover:underline">Login here</a>.
      </p>
    </div>
  </div>
</section>