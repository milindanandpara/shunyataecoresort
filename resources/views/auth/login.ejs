<section class="login pt-24 relative">
  <!-- Background Image -->
  <div class="absolute inset-0 bg-cover bg-center"
       style="background-image: url('/img/login.jpeg');">
  </div>

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-black/70 via-green-900/60 to-black/70"></div>

  <div class="relative min-h-full flex items-center justify-center py--2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-white/90 backdrop-blur-md rounded-2xl shadow-2xl p-8">
      
      <div class="text-center">
        <h2 class="text-3xl font-extrabold text-green-800 drop-shadow">
          Login to Your Account
        </h2>

        <% if (messages.success) { %>
          <div class="mt-4 p-3 bg-green-100 text-green-800 rounded-lg"><%= messages.success %></div>
        <% } %>

        <% if (messages.error) { %>
          <div class="mt-4 p-3 bg-red-100 text-red-800 rounded-lg"><%= messages.error %></div>
        <% } %>
      </div>

      <!-- 🔥 GOOGLE LOGIN BUTTON -->
      <a href="/auth/google"
        class="w-full flex items-center justify-center gap-3 border border-gray-300 py-3 rounded-lg bg-white hover:bg-gray-100 transition shadow-sm">
        
        <img src="https://developers.google.com/identity/images/g-logo.png" width="20">
        <span class="text-sm font-medium text-gray-700">
          Continue with Google
        </span>
      </a>

      <!-- OR DIVIDER -->
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-gray-300"></div>
        <span class="text-gray-500 text-sm">OR</span>
        <div class="flex-1 h-px bg-gray-300"></div>
      </div>

      <!-- FORM -->
      <form class="space-y-6" action="/login" method="POST">
        <input type="hidden" name="remember" value="true">

        <!-- Email -->
        <div>
          <input name="email" type="email" required
            class="block w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-green-500"
            placeholder="Email Address">
        </div>

        <!-- Password -->
        <div>
          <input name="password" type="password" required
            class="block w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-green-500"
            placeholder="Password">
        </div>

        <!-- Remember + Register -->
        <div class="flex items-center justify-between">
          <label class="flex items-center text-sm">
            <input type="checkbox" class="mr-2">
            Remember me
          </label>

          <a href="/register"
            class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
            Sign Up
          </a>
        </div>

        <!-- Forgot Password -->
        <div class="text-center">
          <a href="/forgot-password" class="text-sm text-green-700 hover:underline">
            Forgot your password?
          </a>
        </div>

        <!-- Submit -->
        <button type="submit"
          class="w-full py-3 rounded-lg text-white bg-green-600 hover:bg-green-700 transition">
          Login
        </button>
      </form>

    </div>
  </div>
</section>