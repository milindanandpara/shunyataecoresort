<section class="register pt-24 relative">
   <!-- Background Image -->
  <div class="absolute inset-0 bg-cover bg-center"
       style="background-image: url('/img/login.jpeg');">
  </div>

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-black/70 via-green-900/60 to-black/70"></div>

  <!-- Form Content -->
  <div class="relative min-h-full flex items-center justify-center py--2 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white/90 backdrop-blur-md rounded-2xl shadow-2xl p-8">
      <div class="text-center">
        <h2 class="text-3xl font-extrabold text-green-800 drop-shadow">Create Your Account</h2>

        <% if (messages.success) { %>
          <div class="mt-4 p-3 bg-green-100 text-green-800 rounded-lg"><%= messages.success %></div>
        <% } %>

        <% if (messages.error) { %>
          <div class="mt-4 p-3 bg-red-100 text-red-800 rounded-lg"><%= messages.error %></div>
        <% } %>
      </div>

      <form class="mt-6 space-y-6" action="/register" method="POST">
        <!-- Full Name -->
        <div>
          <input id="name" name="name" type="text" value="<%= messages.name || '' %>" required
            class="block w-full px-4 py-3 rounded-lg border border-gray-300 placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 sm:text-sm"
            placeholder="Full Name">
        </div>

        <!-- Email -->
        <div>
          <input id="email-address" name="email" type="email" value="<%= messages.email || '' %>" autocomplete="email" required
            class="block w-full px-4 py-3 rounded-lg border border-gray-300 placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 sm:text-sm"
            placeholder="Email Address">
        </div>

        <!-- Password -->
        <div>
          <input id="password" name="password" type="password" autocomplete="new-password" required
            class="block w-full px-4 py-3 rounded-lg border border-gray-300 placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 sm:text-sm"
            placeholder="Password">
        </div>

        <!-- Remember + Login -->
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <input id="remember-me" name="remember-me" type="checkbox"
              class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded">
            <label for="remember-me" class="ml-2 block text-sm text-gray-900">
              Remember me
            </label>
          </div>

          <div class="text-sm">
            <a href="/login"
              class="bg-green-600 text-white px-4 py-2 rounded-lg shadow hover:bg-green-700 transition">
              Login
            </a>
          </div>
        </div>

        <!-- Submit -->
        <div>
          <button type="submit"
            class="w-full flex justify-center py-3 px-4 text-sm font-semibold rounded-lg text-white bg-green-600 shadow-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition">
            Register
          </button>
        </div>
      </form>
    </div>
  </div>
</section>